# Server-side only (used by Next.js API routes under app/api/*)
BACKEND_URL=http://localhost:8000

# Shared secret used to call the backend via the x-api-key header.
# Use a real value in `.env.local` (never commit real keys).
EXTERNAL_API_KEY=__REPLACE_WITH_REAL_KEY__

# Backend request timeout (milliseconds)
BACKEND_TIMEOUT_MS=60000

